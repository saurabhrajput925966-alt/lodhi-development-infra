Lodhi Development & Indra Pvt. Ltd. - Property buying, selling and real estate marketplace.
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lodhi Developers & Infra Pvt. Ltd.</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial;background:#f5f7fa;color:#172b46}
header{background:#0c315c;color:white;padding:18px 5%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap}
.logo{font-weight:bold;color:#ffbe26;font-size:19px}
nav a{color:white;text-decoration:none;margin:8px;font-size:14px}
.hero{padding:65px 5%;color:white;background:linear-gradient(90deg,#082849dd,#0b4479cc),url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1500&q=80') center/cover}
.hero h1{font-size:42px;max-width:750px}
.hero p{font-size:17px}
.search,.formbox{background:white;padding:18px;border-radius:12px;display:flex;gap:10px;flex-wrap:wrap;margin-top:25px}
input,select,textarea{padding:12px;border:1px solid #ddd;border-radius:6px;flex:1;min-width:140px}
button,.btn{background:#ffb91f;color:#122d4d;border:0;padding:13px 18px;border-radius:7px;font-weight:bold;cursor:pointer}
section{padding:45px 5%}
h2{text-align:center}
.filters{text-align:center;margin:20px}
.filters button{margin:4px;background:white;border:1px solid #ccc}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px}
.card{background:white;border-radius:12px;overflow:hidden;box-shadow:0 4px 14px #0001}
.card img{width:100%;height:200px;object-fit:cover}
.info{padding:16px}
.price{color:#bc8500;font-size:23px;font-weight:bold}
.card p{color:#666}
.card button{margin-top:8px}
.form-section{background:#eaf0f6}
.formbox{max-width:900px;margin:20px auto;display:grid;grid-template-columns:repeat(2,1fr)}
.formbox textarea{grid-column:span 2}
.formbox button{grid-column:span 2}
footer{background:#082849;color:white;padding:35px 5%;text-align:center}
footer a{color:#ffbe26}
@media(max-width:600px){.hero h1{font-size:29px}.formbox{grid-template-columns:1fr}.formbox textarea,.formbox button{grid-column:span 1}nav{margin-top:10px}}
</style>
</head>
<body>

<header>
<div class="logo">🏛️ LODHI DEVELOPERS & INFRA</div>
<nav>
<a href="#home">Home</a>
<a href="#properties">Properties</a>
<a href="#list">List Property</a>
<a href="#contact">Contact</a>
</nav>
</header>

<div class="hero" id="home">
<h1>LODHI DEVELOPERS & INFRA PVT. LTD.</h1>
<h3 style="color:#ffbe26">Your Dream Property, Our Responsibility!</h3>
<p>Buy • Sell • Rent • Invest — Find your property across India.</p>
<div class="search">
<input id="citySearch" placeholder="City / Location">
<select id="typeSearch">
<option value="">All Types</option>
<option>House</option><option>Apartment</option>
<option>Plot</option><option>Commercial</option>
</select>
<button onclick="search()">SEARCH PROPERTY</button>
</div>
</div>

<section id="properties">
<h2>🏠 Available Properties</h2>
<div class="filters">
<button onclick="filterType('')">All</button>
<button onclick="filterType('Buy')">Buy</button>
<button onclick="filterType('Rent')">Rent</button>
</div>
<div class="grid" id="cards"></div>
</section>

<section class="form-section" id="list">
<h2>＋ List Your Property</h2>
<p style="text-align:center">Fill details below to add your property listing</p>
<form class="formbox" id="propertyForm">
<input id="pTitle" placeholder="Property Title" required>
<input id="pCity" placeholder="City / Location" required>
<select id="pType" required>
<option value="">Property Type</option>
<option>House</option><option>Apartment</option>
<option>Plot</option><option>Commercial</option>
</select>
<select id="pMode">
<option>Buy</option><option>Rent</option>
</select>
<input id="pPrice" placeholder="Price (₹)" required>
<input id="pDetails" placeholder="Area / Bedrooms / Details">
<input id="pImage" placeholder="Image URL (optional)">
<textarea id="pDesc" placeholder="Property Description"></textarea>
<button type="submit">＋ ADD PROPERTY</button>
</form>
</section>

<section id="contact">
<h2>Contact Our Team</h2>
<p style="text-align:center">Call us for property details, buying or selling.</p>
<div style="text-align:center;line-height:2.2">
<a href="tel:7055570306">📞 7055570306</a><br>
<a href="tel:9149300703">📞 9149300703</a><br>
<a href="mailto:info@lodhidevelopers.in">✉️ info@lodhidevelopers.in</a>
</div>
</section>

<footer>
<h3>LODHI DEVELOPERS & INFRA PVT. LTD.</h3>
<p>Buy • Sell • Rent • Invest</p>
<p>📞 7055570306 | 9149300703</p>
<p>✉️ info@lodhidevelopers.in</p>
<p>© 2026 All Rights Reserved</p>
</footer>

<script>
const sample=[
{title:"Luxury Family House",city:"Delhi",type:"House",mode:"Buy",price:"₹85,00,000",details:"3 BHK • 1800 Sq Ft",img:"https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80"},
{title:"Premium Apartment",city:"Noida",type:"Apartment",mode:"Buy",price:"₹45,00,000",details:"2 BHK • 1200 Sq Ft",img:"https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=800&q=80"},
{title:"Residential Plot",city:"Gurugram",type:"Plot",mode:"Buy",price:"₹25,00,000",details:"200 Sq Yards",img:"https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=800&q=80"}
];
let added=JSON.parse(localStorage.getItem("lodhiListings")||"[]");
let modeFilter="";
function all(){return [...sample,...added]}
function show(list){
let el=document.getElementById("cards");
el.innerHTML="";
if(!list.length){el.innerHTML="<p>No properties found.</p>";return}
list.forEach(p=>{
el.innerHTML+=`<div class="card">
<img src="${p.img||'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=800&q=80'}">
<div class="info"><div class="price">${p.price}</div>
<h3>${p.title}</h3><p>📍 ${p.city}</p>
<p>${p.type} • ${p.mode}</p><p>${p.details||""}</p>
<a href="https://wa.me/917055570306?text=${encodeURIComponent('I am interested in '+p.title+' in '+p.city)}"><button>WhatsApp Enquiry</button></a>
</div></div>`;
});
}
function search(){
let c=document.getElementById("citySearch").value.toLowerCase();
let t=document.getElementById("typeSearch").value;
show(all().filter(p=>(!c||p.city.toLowerCase().includes(c))&&(!t||p.type===t)&&(!modeFilter||p.mode===modeFilter)));
}
function filterType(t){modeFilter=t;search()}
document.getElementById("propertyForm").addEventListener("submit",e=>{
e.preventDefault();
let p={title:pTitle.value,city:pCity.value,type:pType.value,mode:pMode.value,price:pPrice.value,details:pDetails.value,desc:pDesc.value,img:pImage.value};
added.unshift(p);
localStorage.setItem("lodhiListings",JSON.stringify(added));
e.target.reset();
show(all());
alert("Property added to this browser!");
});
show(all());
</script>
</body>
</html>
<section style="padding:30px;background:#f4f6f9">
<h2 style="text-align:center;color:#173b68">Available Properties</h2>

<div style="background:white;padding:15px;border-radius:12px;margin:15px auto;max-width:400px">
<img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=800&q=80" style="width:100%;border-radius:10px">
<h3>Residential Plot for Sale</h3>
<p>📍 Location: Your City</p>
<p>📐 Size: 1000 Sq.ft.</p>
<p>💰 Price: ₹15,00,000</p>
<p>Property Type: Plot</p>
<a href="https://wa.me/919149300703?text=I%20am%20interested%20in%20this%20property" style="display:block;background:#198754;color:white;text-align:center;padding:12px;border-radius:8px;text-decoration:none">WhatsApp for Details</a>
</div>
</section>
